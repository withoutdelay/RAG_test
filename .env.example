APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-random-string
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
# Optional multi-user auth. Supports "user:password_or_hash;user2:password_or_hash" or a JSON object.
AUTH_USERS=
AUTH_SESSION_COOKIE_NAME=presale_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=
COMPOSE_PROJECT_NAME=rag_test
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CPUS=1.5
BACKEND_MEMORY_LIMIT=6g
BACKEND_MEMORY_SWAP_LIMIT=6g
GATEWAY_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_EXTRAS=parsing
INSTALL_CPU_TORCH=true
INSTALL_LIBREOFFICE=true
APT_MIRROR=
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:20-alpine
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=
HF_ENDPOINT=https://huggingface.co
HF_HOME=/opt/huggingface
DOCLING_CACHE_DIR=/opt/docling/cache
# Set DOCLING_ARTIFACTS_PATH only when model artifacts have been prewarmed into that directory.
# DOCLING_ARTIFACTS_PATH=/opt/docling/models
PREWARM_DOCLING_MODELS=false
DOCLING_PREWARM_MODELS_ON_STARTUP=false
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_COOKIE_NAME=presale_session
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://backend:8000
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.12.4
MINIO_IMAGE=minio/minio:latest

POSTGRES_DB=copilot_db
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot

DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot_db
CONTAINER_DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot_db
REDIS_URL=redis://localhost:6379/0
CONTAINER_REDIS_URL=redis://redis:6379/0
GATEWAY_REDIS_URL=redis://redis:6379/1

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCATION=
QDRANT_COLLECTION=presale_knowledge_qwen3_vl_embedding
# Local parser is the safe default until Alibaba Cloud Document Mind is purchased/configured.
# Set PARSER_BACKEND=aliyun_docmind only after ALIYUN_DOCMIND_ACCESS_KEY_* is available.
PARSER_BACKEND=docling
DOCLING_LIBREOFFICE_CMD=
PARSER_CPU_THREADS=1
PARSER_PROCESS_ISOLATION_ENABLED=true
PARSER_DOCUMENT_TIMEOUT_SECONDS=7200
PARSER_CLOUD_FALLBACK_ENABLED=true
PARSER_CLOUD_DIRECT_MIN_BYTES=31457280
ALIYUN_DOCMIND_ACCESS_KEY_ID=
ALIYUN_DOCMIND_ACCESS_KEY_SECRET=
ALIYUN_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
ALIYUN_DOCMIND_POLL_INTERVAL_SECONDS=2
ALIYUN_DOCMIND_TIMEOUT_SECONDS=900
ALIYUN_DOCMIND_LLM_ENHANCEMENT=false
ALIYUN_DOCMIND_ENHANCEMENT_MODE=
ALIYUN_DOCMIND_FORMULA_ENHANCEMENT=false
ALIYUN_DOCMIND_OUTPUT_HTML_TABLE=true
ALIYUN_DOCMIND_FETCH_IMAGE_ASSETS=true
ALIYUN_DOCMIND_MAX_IMAGE_ASSETS=80
ALIYUN_DOCMIND_MAX_IMAGE_BYTES=5000000
ALIYUN_DOCMIND_CONVERT_OFFICE_TO_PDF_MIN_BYTES=31457280
PARSER_LLM_ASSET_REVIEW_ENABLED=true
PARSER_LLM_ASSET_REVIEW_MAX_ASSETS=24
PARSER_LLM_ASSET_REVIEW_CONFIDENCE_THRESHOLD=0.72
PARSER_LLM_ASSET_REVIEW_USE_VISION=true
PARSER_LLM_ASSET_REVIEW_IMAGE_DETAIL=auto
PARSER_LLM_ASSET_REVIEW_MAX_IMAGE_BYTES=2000000
PARSER_LLM_ASSET_REVIEW_TIMEOUT_SECONDS=45
PARSER_LLM_ASSET_SUMMARY_ENABLED=true
PARSER_LLM_ASSET_SUMMARY_MAX_ASSETS=24
PARSER_LLM_ASSET_SUMMARY_USE_VISION=true
PARSER_LLM_ASSET_SUMMARY_IMAGE_DETAIL=auto
PARSER_LLM_ASSET_SUMMARY_MAX_IMAGE_BYTES=2000000
PARSER_LLM_ASSET_SUMMARY_TIMEOUT_SECONDS=60
RUNTIME_ASSET_VISION_GATE_ENABLED=true
RUNTIME_ASSET_VISION_GATE_MAX_ASSETS=8
RUNTIME_ASSET_VISION_GATE_IMAGE_DETAIL=auto
RUNTIME_ASSET_VISION_GATE_MAX_IMAGE_BYTES=2000000
RUNTIME_ASSET_VISION_GATE_TIMEOUT_SECONDS=18
PARSER_ASSET_QUALITY_GATE_ENABLED=true
SAFE_INGESTION_ENABLED=true
FORMULA_OCR_BACKEND=none
FORMULA_OCR_MAX_ASSETS=3
FORMULA_OCR_MAX_REGIONS_PER_ASSET=3
EMBEDDING_BACKEND=dashscope-multimodal
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT_PATH=/services/embeddings/multimodal-embedding/multimodal-embedding
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_DEVICE=cpu
BACKGROUND_JOB_WORKER_COUNT=1
# Layered task queues (introduced 2026-05): isolate realtime customer flows from
# long-running historical ingestion and background maintenance.  Each queue has
# its own worker pool + PriorityQueue + dedupe namespace.  BACKGROUND_JOB_WORKER_COUNT
# above is kept only as a legacy fallback and will be removed in a future release.
INTERACTIVE_JOB_WORKER_COUNT=3
LIBRARY_PARSE_JOB_WORKER_COUNT=1
MAINTENANCE_JOB_WORKER_COUNT=1
# RFP light parse: project RFP uploads use a lightweight text-only extractor instead
# of the heavy historical ingestion pipeline (no chunking, no embedding, no Qdrant
# writes, no figure/table asset extraction, no case library refresh).
RFP_LIGHT_PARSE_ENABLED=true
RFP_LIGHT_PARSE_MAX_SECONDS=60
RFP_LIGHT_PARSE_MAX_PAGES=30
RFP_LIGHT_PARSE_MAX_CHARS=80000
RFP_LIGHT_PARSE_EXCERPT_CHARS=20000
RFP_LIGHT_PARSE_STORE_FULL_TEXT=true
RFP_LIGHT_PARSE_EMBEDDING_ENABLED=false
# Max worker threads in the dedicated RFP light parse executor; isolates slow PDF
# parsing from the global asyncio default executor so a stuck file cannot saturate it.
RFP_LIGHT_PARSE_MAX_WORKERS=2
# OCR/layout fallback for scanned or image-heavy project RFPs. Text PDFs stay on
# the fast local path; low-text PDFs or unsupported legacy docs use Aliyun DocMind.
RFP_LIGHT_PARSE_CLOUD_FALLBACK_ENABLED=true
RFP_LIGHT_PARSE_CLOUD_FALLBACK_MIN_CHARS=500
RFP_LIGHT_PARSE_CLOUD_FALLBACK_MIN_CHARS_PER_PAGE=30
# Placeholder for future RFP knowledge extraction (Phase 4); keep disabled.
RFP_KNOWLEDGE_EXTRACT_ENABLED=false

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=presale-documents

DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=sk-xxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_STYLE=auto

VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://your-vision-relay.example.com/v1
VISION_LLM_MODEL=gpt-4o-mini
VISION_LLM_API_STYLE=auto

GATEWAY_URL=http://localhost:8001
GATEWAY_MASKING_ENABLED=true
LEGACY_GENERATION_ENABLED=false
VALIDATION_REQUIRE_FINAL_REVIEW=false
EXPORT_HOLISTIC_FINALIZATION_ENABLED=false
EXPORT_HOLISTIC_FINALIZATION_MODE=section
LLM_PROVIDER_BACKEND=mock
LLM_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=45
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=1.0
SECTION_GENERATION_CONCURRENCY=1
SECTION_GENERATION_QUALITY_GATE=full
SECTION_GENERATION_FAST_COHERENCE_PASS=true
SECTION_GENERATION_ITEM_TIMEOUT_SECONDS=480
SECTION_GENERATION_GRANULARITY=top_level
SECTION_REUSE_CONTEXT_MODE=prefer_full_section
SECTION_REUSE_CANDIDATE_LIMIT=16
SECTION_REUSE_FULL_SECTION_BLOCK_LIMIT=32
SECTION_REUSE_FULL_SECTION_BUDGET_ENABLED=false
SECTION_REUSE_FULL_SECTION_MAX_TOKENS=4000
# Optional external semantic guardrail rules. Leave empty to use the repository default.
SEMANTIC_RULES_PATH=
EVIDENCE_JUDGE_MODE=auto
EVIDENCE_JUDGE_MAX_CANDIDATES=10
EVIDENCE_JUDGE_TIMEOUT_SECONDS=45
CASE_LIBRARY_SECTION_RERANK_ENABLED=true
CASE_LIBRARY_SECTION_SEMANTIC_ENABLED=true
