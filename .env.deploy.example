APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-random-secret

DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot_db
REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=presale_knowledge
EMBEDDING_DEVICE=cpu
BACKGROUND_JOB_WORKER_COUNT=1
# Layered task queues (introduced 2026-05); BACKGROUND_JOB_WORKER_COUNT above kept as legacy fallback.
INTERACTIVE_JOB_WORKER_COUNT=3
LIBRARY_PARSE_JOB_WORKER_COUNT=1
MAINTENANCE_JOB_WORKER_COUNT=1
RFP_LIGHT_PARSE_ENABLED=true
RFP_LIGHT_PARSE_MAX_SECONDS=60
RFP_LIGHT_PARSE_MAX_PAGES=30
RFP_LIGHT_PARSE_MAX_CHARS=80000
RFP_LIGHT_PARSE_EXCERPT_CHARS=20000
RFP_LIGHT_PARSE_STORE_FULL_TEXT=true
RFP_LIGHT_PARSE_EMBEDDING_ENABLED=false
RFP_LIGHT_PARSE_MAX_WORKERS=2
RFP_KNOWLEDGE_EXTRACT_ENABLED=false
# Server/customer deployments should prefer the lightweight Aliyun DocMind SDK
# extra. Use BACKEND_EXTRAS=parsing only when local Docling is intentionally
# enabled and the server can tolerate the torch/model dependencies.
BACKEND_EXTRAS=aliyun-docmind
INSTALL_CPU_TORCH=false
INSTALL_LIBREOFFICE=false
PARSER_BACKEND=aliyun_docmind
PARSER_CPU_THREADS=1
PARSER_PROCESS_ISOLATION_ENABLED=true
PARSER_DOCUMENT_TIMEOUT_SECONDS=7200
PARSER_CLOUD_FALLBACK_ENABLED=true
PARSER_CLOUD_DIRECT_MIN_BYTES=31457280
ALIYUN_DOCMIND_ACCESS_KEY_ID=
ALIYUN_DOCMIND_ACCESS_KEY_SECRET=
ALIYUN_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-access-key
MINIO_SECRET_KEY=replace-minio-secret-key
MINIO_BUCKET=presale-documents

GATEWAY_URL=http://gateway:8001
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com/api/v1

LLM_PROVIDER_BACKEND=live
SECTION_GENERATION_CONCURRENCY=1
SECTION_GENERATION_QUALITY_GATE=full
SECTION_GENERATION_FAST_COHERENCE_PASS=true
SECTION_GENERATION_ITEM_TIMEOUT_SECONDS=480
SECTION_GENERATION_GRANULARITY=top_level
SECTION_REUSE_CONTEXT_MODE=prefer_full_section
SECTION_REUSE_CANDIDATE_LIMIT=16
SECTION_REUSE_FULL_SECTION_BLOCK_LIMIT=32
SECTION_REUSE_FULL_SECTION_BUDGET_ENABLED=false
SECTION_REUSE_FULL_SECTION_MAX_TOKENS=4000
EVIDENCE_JUDGE_MODE=auto
EVIDENCE_JUDGE_MAX_CANDIDATES=10
EVIDENCE_JUDGE_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_STYLE=auto
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=gpt-4o-mini
VISION_LLM_API_STYLE=auto
RUNTIME_ASSET_VISION_GATE_ENABLED=true
RUNTIME_ASSET_VISION_GATE_MAX_ASSETS=4
RUNTIME_ASSET_VISION_GATE_IMAGE_DETAIL=auto
RUNTIME_ASSET_VISION_GATE_MAX_IMAGE_BYTES=800000
RUNTIME_ASSET_VISION_GATE_TIMEOUT_SECONDS=18
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=azure-gpt
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615
