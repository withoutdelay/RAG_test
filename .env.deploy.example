APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-random-secret

DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot_db
REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=presale_knowledge
EMBEDDING_DEVICE=cpu
BACKGROUND_JOB_WORKER_COUNT=1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-access-key
MINIO_SECRET_KEY=replace-minio-secret-key
MINIO_BUCKET=presale-documents

GATEWAY_URL=http://gateway:8001
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com/api/v1

LLM_PROVIDER_BACKEND=live
SECTION_GENERATION_CONCURRENCY=1
SECTION_GENERATION_QUALITY_GATE=full
SECTION_GENERATION_FAST_COHERENCE_PASS=true
SECTION_GENERATION_GRANULARITY=top_level
SECTION_REUSE_CONTEXT_MODE=prefer_full_section
SECTION_REUSE_CANDIDATE_LIMIT=16
SECTION_REUSE_FULL_SECTION_BLOCK_LIMIT=32
SECTION_REUSE_FULL_SECTION_BUDGET_ENABLED=false
SECTION_REUSE_FULL_SECTION_MAX_TOKENS=4000
EVIDENCE_JUDGE_MODE=auto
EVIDENCE_JUDGE_MAX_CANDIDATES=10
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_STYLE=auto
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=gpt-4o-mini
VISION_LLM_API_STYLE=auto
RUNTIME_ASSET_VISION_GATE_ENABLED=true
RUNTIME_ASSET_VISION_GATE_MAX_ASSETS=4
RUNTIME_ASSET_VISION_GATE_IMAGE_DETAIL=auto
RUNTIME_ASSET_VISION_GATE_MAX_IMAGE_BYTES=800000
RUNTIME_ASSET_VISION_GATE_TIMEOUT_SECONDS=18
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=azure-gpt
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615
