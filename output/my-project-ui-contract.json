{
  "style_direction": "Engineering desk, structured, auditable, dense but readable; use neutral surfaces with engineering blue-gray accents and avoid consumer chat-shell aesthetics.",
  "typography": {
    "primary_font": "Inter",
    "mono_font": "var(--font-mono, ui-monospace, SFMono-Regular, monospace)",
    "body_scale": "14/16/20/24",
    "notes": "Primary UI text uses Inter; technical trace blocks may use the mono stack."
  },
  "icon_system": "lucide-react",
  "emoji_policy": {
    "allowed_in_ui": false,
    "allowed_as_icon": false,
    "allowed_during_development": false,
    "rule": "UI 与开发过程都禁止 emoji，图标只能来自 lucide-react。"
  },
  "component_stack": {
    "primary": "shadcn/ui",
    "headless": "Radix UI",
    "styling": "Tailwind CSS v4",
    "feedback": "sonner",
    "icon": "lucide-react"
  },
  "ui_library_preference": {
    "primary": [
      "shadcn/ui",
      "Radix UI"
    ],
    "fallback": [
      "native semantic HTML for narrow review widgets only"
    ],
    "final_selected": "shadcn/ui + Radix UI + Tailwind CSS v4 + sonner"
  },
  "design_tokens": {
    "color": {
      "canvas": "var(--color-canvas)",
      "surface": "var(--color-surface)",
      "surface_muted": "var(--color-surface-muted)",
      "border": "var(--color-border)",
      "text": "var(--color-text)",
      "text_muted": "var(--color-text-muted)",
      "primary": "var(--color-primary)",
      "success": "var(--color-success)",
      "warning": "var(--color-warning)",
      "danger": "var(--color-danger)",
      "info": "var(--color-info)"
    },
    "spacing": {
      "sm": "var(--space-3)",
      "md": "var(--space-4)",
      "lg": "var(--space-6)"
    },
    "radius": {
      "card": "var(--radius-md)",
      "control": "var(--radius-sm)"
    },
    "shadow": {
      "panel": "var(--shadow-panel)"
    }
  },
  "layout_skeleton": {
    "top_stage_bar": true,
    "three_column_workbench": true,
    "right_trace_panel": true
  },
  "anti_patterns": [
    "No Claude/ChatGPT-style sidebar chat shell",
    "No gradient hero or decorative orb backgrounds",
    "No emoji icons",
    "No purple/pink AI-template palette"
  ]
}
